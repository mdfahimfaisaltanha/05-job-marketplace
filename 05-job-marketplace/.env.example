# --- Required ---------------------------------------------------------------
# Postgres connection string (Neon/Supabase free tier works).
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Optional: Stripe Connect (TEST MODE ONLY) --------------------------------
# Leave blank to run in built-in MOCK escrow mode — the full fund/release/
# refund/split lifecycle works end to end with mock references, no Stripe
# account needed. Set a TEST key (sk_test_...) to hit real Stripe test-mode
# APIs: PaymentIntents for escrow holds, Transfers for payouts, Refunds for
# refunds. Live keys (sk_live_...) are rejected on purpose.
STRIPE_SECRET_KEY=

# Platform fee in basis points taken from the freelancer payout on release.
# 1000 = 10%. Optional, defaults to 1000.
PLATFORM_FEE_BPS=1000

# Password used for all seeded demo accounts (optional).
SEED_PASSWORD=ChangeMe123!
